    },
    {
      "source": "/api/notifications/test-send",
      "destination": "/api/notifications?subpath=test-send"
    },
    {
      "source": "/api/returns",
      "destination": "/api/returns"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
